# Docker Compose config for the NAS stack. Copy to .env and fill in.
#   cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=hotwheels
POSTGRES_USER=hotwheels
# Any long random string. Only the containers ever use it.
POSTGRES_PASSWORD=CHANGE_ME

# ─── Backend ─────────────────────────────────────────────────────────────────
# Signs login tokens. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing this logs everyone out.
JWT_SECRET=CHANGE_ME

# How long a login lasts. 30 days means you rarely re-enter a password on your phone.
TOKEN_TTL_DAYS=30

# ─── Ports ───────────────────────────────────────────────────────────────────
# NAS operating systems reserve a lot of low ports for themselves (UGREEN uses
# 8000 among others), so both of these are worth changing if a container fails
# to bind. Check what's taken with:  sudo netstat -tlnp | grep <port>

# The website — this is the one you open in a browser.
# Deliberately a high, uncommon port: 8080/8090 are frequently already taken on
# a NAS (upsnap holds 8090 on this one).
FRONTEND_PORT=18080

# The API. Only needed for direct access and debugging; the website reaches the
# backend internally through the frontend container's proxy.
BACKEND_PORT=8000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Only matters if something calls the API from a *different* origin than it is
# served on — e.g. running `npm run dev` locally against the NAS, or a frontend
# still hosted on Netlify. When you use the bundled frontend container this can
# be left as-is, because those requests are same-origin and never hit CORS.
# Must match the browser's address bar exactly: scheme + host + port.
ALLOWED_ORIGINS=http://localhost:5173
