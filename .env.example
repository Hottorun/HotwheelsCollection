# Docker Compose config for the NAS stack. Copy to .env and fill in.
#   cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=hotwheels
POSTGRES_USER=hotwheels
# Any long random string. Only the containers ever use it.
POSTGRES_PASSWORD=CHANGE_ME

# ─── Backend ─────────────────────────────────────────────────────────────────
# Signs login tokens. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing this logs everyone out.
JWT_SECRET=CHANGE_ME

# How long a login lasts. 30 days means you rarely re-enter a password on your phone.
TOKEN_TTL_DAYS=30

# Port the API listens on, on the NAS itself.
BACKEND_PORT=8000

# Origins allowed to call the API — wherever the frontend is served from.
# Comma-separated, no trailing slashes, and it must match the browser's address
# bar exactly (scheme + host + port) or the browser blocks the request.
ALLOWED_ORIGINS=http://localhost:5173
