# Postgres on the NAS.
# Inside Docker Compose the host is the service name; from your laptop it's the
# NAS address, e.g. postgresql://hotwheels:password@192.168.1.50:5432/hotwheels
DATABASE_URL=postgresql://hotwheels:CHANGE_ME@db:5432/hotwheels

# Signs the login tokens. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing this logs everyone out.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_48_CHAR_STRING

# How long a login lasts before it needs redoing.
TOKEN_TTL_DAYS=30

# Account granted admin rights (the user-management page) on startup.
ADMIN_EMAIL=hottorun@pm.me

# Where car images are written. In Docker this is a mounted volume.
IMAGE_DIR=/data/car-images

# Comma-separated origins allowed to call the API — your frontend URL(s).
ALLOWED_ORIGINS=http://localhost:5173
